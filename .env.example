# PiGuard Electron App - Backend Configuration
# Copy this file to .env and update the values

# Backend server URL (the FastAPI WebSocket server)
# For local development: http://localhost:8000 and ws://localhost:8000
# For production: https://your-server.example.com and wss://your-server.example.com
BACKEND_HTTP_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000

# Admin bearer token - must match ADMIN_BEARER_TOKEN in the server's .env file
ADMIN_BEARER_TOKEN=change-me-admin-token

# Target device ID - the Android device ID to send commands to
# This is typically the Android ID from the mobile app
TARGET_DEVICE_ID=default-device

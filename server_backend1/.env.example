# Copy to .env on the server (~/backend_tracking/.env)
HOST=0.0.0.0
PORT=8000

# Bearer tokens (use long random strings in production)
ADMIN_BEARER_TOKEN=change-me-admin-token
MOBILE_BEARER_TOKEN=change-me-mobile-token

# Set true only for local dev — never in production
ALLOW_UNAUTHENTICATED=false

# SQLite path for audit log (relative to cwd or absolute)
SQLITE_PATH=./data/command_audit.db

# Supabase tracking storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
SUPABASE_TRACKING_TABLE=tracking_locations
SUPABASE_TRACKING_LATEST_VIEW=tracking_latest_locations
